---
/**
 * BYQ Supply — "FAQ Accordion Two Column" (evermind-faq-1)
 * https://app.byq.supply/sections/evermind-faq-1
 *
 * Preserved: the two-column split with intro copy plus a CTA button on the
 * left and the accordion on the right, rounded item cards, the plus icon
 * whose vertical bar collapses into a minus on open, the max-height slide,
 * and the single-column stack below 991px.
 */
import { faqs, event } from "../data/event";
import ScatterIcons from "./ScatterIcons.astro";
---

<section
  id="faq"
  class="pattern pattern--fade pattern--soft relative bg-cream py-[150px] max-[991px]:py-[120px] max-[479px]:py-[96px]"
>
  <ScatterIcons variant="d" opacity={0.35} />

  <div class="relative z-[1] mx-auto w-full max-w-[1400px] px-6 max-[479px]:px-4">
    <div
      class="grid grid-cols-[0.85fr_1.15fr] items-start gap-14 max-[991px]:grid-cols-1 max-[991px]:gap-10"
    >
      {/* Left */}
      <div data-reveal class="flex flex-col items-start gap-5">
        <div
          class="flex h-8 items-center justify-center rounded-pill border border-gold bg-gold/15 px-5 font-mono text-[0.8125rem] font-medium tracking-[1.5px] text-gold-deep uppercase"
        >
          FAQ
        </div>
        <h2
          class="headline m-0 font-display text-navy-ink uppercase"
        >
          You ask,<br /><span class="script feather-text">we answer</span>
        </h2>
        <p class="m-0 max-w-[40ch] text-[1.125rem] leading-[1.6] text-navy-ink/85">
          Still stuck? Message the race office on Facebook, or email us — we
          answer within a working day.
        </p>
        <a
          href={`mailto:${event.infoEmail}`}
          class="mt-2 inline-flex h-12 items-center justify-center rounded-pill bg-gold-deep px-7 font-body text-[1.125rem] font-bold text-white no-underline transition-colors duration-300 hover:bg-gold"
        >
          Email the race office
        </a>
      </div>

      {/* Right — accordion */}
      <div class="flex flex-col gap-2.5">
        {
          faqs.map((faq, i) => (
            <div class="rounded-2xl bg-cream-card px-6 py-5 shadow-[0_1px_3px_rgba(1,20,58,0.07)] max-[479px]:px-5 max-[479px]:py-4">
              <button
                type="button"
                data-faq-toggle
                aria-expanded={i === 0 ? "true" : "false"}
                class="flex w-full cursor-pointer items-start justify-between gap-8 text-left max-[479px]:gap-4"
              >
                <span class="type-h5 font-display text-navy-ink">
                  {faq.q}
                </span>
                <span class="relative mt-[6px] flex h-[14px] w-[14px] flex-shrink-0 items-center justify-center">
                  <span class="absolute h-[1.5px] w-[14px] bg-rose" />
                  <span
                    data-faq-bar
                    class:list={[
                      "absolute w-[1.5px] bg-rose transition-all duration-300",
                      i === 0 ? "h-0 opacity-0" : "h-[14px] opacity-100",
                    ]}
                  />
                </span>
              </button>

              {/* The panel animates its real height, via a grid row that
                  goes from 0fr to 1fr — `max-height` cannot, because it has
                  to guess a ceiling far taller than the answer, which is
                  what made the old open and close feel abrupt. */}
              <div
                data-faq-panel
                class:list={["faq-panel", i === 0 && "is-open"]}
              >
                <div class="faq-panel__inner">
                  <p class="mt-0 mb-0 pt-3 text-[1.125rem] leading-[1.6] text-navy-ink/85">
                    {faq.a}
                  </p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const toggles = document.querySelectorAll<HTMLButtonElement>("[data-faq-toggle]");

  const panelOf = (btn: HTMLButtonElement) =>
    btn.parentElement?.querySelector<HTMLElement>("[data-faq-panel]");

  const setOpen = (btn: HTMLButtonElement, open: boolean) => {
    const panel = panelOf(btn);
    const bar = btn.querySelector<HTMLElement>("[data-faq-bar]");
    panel?.classList.toggle("is-open", open);
    // The vertical stroke of the + retracts to leave the - when open.
    bar?.classList.toggle("h-0", open);
    bar?.classList.toggle("opacity-0", open);
    bar?.classList.toggle("h-[14px]", !open);
    bar?.classList.toggle("opacity-100", !open);
    btn.setAttribute("aria-expanded", String(open));
  };

  toggles.forEach((btn) => {
    btn.addEventListener("click", () => {
      const isOpen = btn.getAttribute("aria-expanded") === "true";
      toggles.forEach((other) => setOpen(other, false));
      if (!isOpen) setOpen(btn, true);
    });
  });
</script>
