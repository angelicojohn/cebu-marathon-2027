---
/**
 * BYQ Supply — "Bento Grid Features with Social Proof" (truebase-bento-1)
 * https://app.byq.supply/sections/truebase-bento-1
 *
 * Preserved: the centred pill-label-plus-H2 header over an asymmetric
 * six-column bento grid, the mix of tile types (a large copy tile spanning
 * two columns and two rows, cover-image tiles, a dark accent tile), the
 * social-proof bar closing the section with an animated CTA, and the
 * grid-wide scroll reveal.
 *
 * Adapted: the tiles carry the race rather than product features — route,
 * kit, raffle, Sinulog and the zero-waste policy — and the closing bar
 * swaps avatars for the AIMS and World Athletics certification marks,
 * which is this event's equivalent social proof.
 */
import { bento, event } from "../data/event";
import ScatterIcons from "./ScatterIcons.astro";
---

<section
  id="race"
  class="pattern pattern--fade pattern--soft relative bg-cream py-[150px] max-[991px]:py-[120px] text-navy-ink max-[479px]:py-[96px]"
>
  <ScatterIcons variant="b" opacity={0.4} />

  <div class="relative z-[1] mx-auto w-full max-w-[1400px] px-6 max-[479px]:px-4">
    {/* Header */}
    <div data-reveal class="mb-12 flex flex-col items-center gap-5 text-center">
      <div
        class="flex h-8 items-center justify-center rounded-pill border border-navy-ink/20 px-5 font-mono text-[13px] font-medium tracking-[1.5px] uppercase"
      >
        The race
      </div>
      <h2
        class="headline m-0 font-display uppercase"
      >
        What you actually <span class="script feather-text">run</span>
      </h2>
    </div>

    {/* Bento grid */}
    <div
      data-reveal
      class="grid grid-cols-6 gap-4 max-[991px]:grid-cols-2 max-[639px]:grid-cols-1"
    >
      {/* Raffle — large lead tile, 4 cols × 2 rows.
          The poster's copy is set as live text, and the car (lifted from
          the official raffle artwork, feathers and all) sits in the lower
          right, bleeding off the card's edge. */}
      <article
        class="raffle-tile relative col-span-4 row-span-2 flex min-h-[620px] flex-col overflow-hidden rounded-2xl p-10 text-bone max-[991px]:col-span-2 max-[991px]:row-span-1 max-[639px]:col-span-1 max-[639px]:min-h-[560px] max-[479px]:p-7"
      >
        <div class="relative z-[1] flex items-start justify-between gap-6 max-[767px]:flex-col-reverse">
          <div class="max-w-[36rem]">
            <span class="font-mono text-[12px] tracking-[2px] text-gold uppercase">
              Every entry
            </span>
            <p class="raffle-kicker mt-4 mb-1">
              Get a chance to <span class="raffle-kicker__script">Bring Home</span> a
            </p>
            <h3 class="m-0 type-h3 font-display uppercase">
              <span class="block whitespace-nowrap max-[479px]:whitespace-normal">Jaecoo J5 Super Hybrid</span>
              <span class="block">System Compact SUV</span>
            </h3>
            <p class="mt-4 mb-0 max-w-[42ch] text-[18px] leading-[1.6] text-bone-64">
              {bento.raffle.body}
            </p>
          </div>
          <div class="flex flex-none flex-col items-end gap-4 max-[767px]:items-start">
            <img
              src="/images/logo-cli-white.png"
              alt="Cebu Marathon 2027"
              width="720"
              height="279"
              loading="lazy"
              class="h-[64px] w-auto"
            />
            <img
              src="/images/sponsor-omoda-jaecoo-white.png"
              alt="OMODA | JAECOO"
              width="256"
              height="15"
              loading="lazy"
              class="h-[14px] w-auto"
            />
          </div>
        </div>

        {/* The car, cut out with Recraft, over the same Sinulog feathers
            used on the call-to-action buttons — set as vector artwork
            rather than lifted from the poster, so their edges stay crisp. */}
        <div class="raffle-tile__stage" aria-hidden="false">
          <img src="/images/leaves/feather-green.svg" alt="" class="raffle-feather raffle-feather--1" />
          <img src="/images/leaves/feather-blue.svg" alt="" class="raffle-feather raffle-feather--2" />
          <img src="/images/leaves/feather-purple.svg" alt="" class="raffle-feather raffle-feather--3" />
          <img src="/images/leaves/feather-blue.svg" alt="" class="raffle-feather raffle-feather--4" />
          <img src="/images/leaves/feather-pink.svg" alt="" class="raffle-feather raffle-feather--5" />
          <img
            src="/images/raffle-car.webp"
            alt="Jaecoo J5 Super Hybrid, the grand raffle prize"
            width="1977"
            height="909"
            loading="lazy"
            class="raffle-tile__car"
          />
        </div>
      </article>

      {/* Kit — photo tile: the photo fills the card and the navy fades up
          behind the copy, like the Sinulog and zero-waste tiles. */}
      <article
        class="relative col-span-2 min-h-[440px] overflow-hidden rounded-2xl max-[639px]:col-span-1 max-[639px]:min-h-[400px]"
      >
        <img
          src={bento.kit.image}
          alt="The 2027 race shirt, finisher shirt and towel on display at the SM Seaside Cube Wing booth"
          loading="lazy"
          width="1080"
          height="970"
          class="absolute inset-0 h-full w-full object-cover object-[50%_30%]"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-navy-950 via-navy-950/55 to-transparent"></div>
        <div class="absolute inset-x-0 bottom-0 p-7">
          <span class="font-mono text-[12px] tracking-[2px] text-gold uppercase">
            Race kit
          </span>
          <h3 class="mt-3 mb-2 type-h5 font-display text-bone uppercase">
            {bento.kit.title}
          </h3>
          <p class="m-0 text-[16px] leading-[1.55] text-bone-88">
            {bento.kit.body}
          </p>
        </div>
      </article>

      {/* Route — photo tile, same treatment as the kit tile. */}
      <article
        class="relative col-span-2 min-h-[440px] overflow-hidden rounded-2xl max-[639px]:col-span-1 max-[639px]:min-h-[440px]"
      >
        <img
          src={bento.route.image}
          alt="Runners crossing the CCLEX at night"
          loading="lazy"
          width="1600"
          height="1020"
          class="absolute inset-0 h-full w-full object-cover object-[50%_25%]"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-navy-950 via-navy-950/60 to-transparent"></div>
        <div class="absolute inset-x-0 bottom-0 p-7">
          <span class="font-mono text-[12px] tracking-[2px] text-aqua uppercase">
            Route map
          </span>
          <h3 class="mt-3 mb-2 type-h5 font-display text-bone uppercase">
            {bento.route.title}
          </h3>
          <p class="m-0 text-[16px] leading-[1.55] text-bone-88">{bento.route.body}</p>
        </div>
      </article>

      {/* Sinulog — cover image tile with overlay copy */}
      <article
        class="relative col-span-3 overflow-hidden rounded-2xl max-[639px]:col-span-1"
      >
        <img
          src={bento.sinulog.image}
          alt="Aerial view of the course at dawn"
          loading="lazy"
          class="h-full min-h-[240px] w-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-navy-950 via-navy-950/40 to-transparent"></div>
        <div class="absolute inset-x-0 bottom-0 p-7">
          <span class="font-mono text-[12px] tracking-[2px] text-gold uppercase">
            Sinulog season
          </span>
          <h3 class="mt-3 mb-2 type-h4 font-display text-bone uppercase">
            {bento.sinulog.title}
          </h3>
          <p class="m-0 max-w-[46ch] text-[16px] leading-[1.55] text-bone-88">
            {bento.sinulog.body}
          </p>
        </div>
      </article>

      {/* Zero waste — photo tile. The runner is from the official
          "How to hydrate?" post, with its text and graphics removed. */}
      <article
        class="relative col-span-3 min-h-[320px] overflow-hidden rounded-2xl max-[639px]:col-span-1"
      >
        <img
          src="/images/hydrate-runner.webp"
          alt="A runner drinking from a cup mid-race"
          loading="lazy"
          width="1400"
          height="1400"
          class="absolute inset-0 h-full w-full object-cover object-[35%_30%]"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-navy-950 via-navy-950/40 to-transparent"></div>
        <div class="absolute inset-x-0 bottom-0 p-7">
          <span class="font-mono text-[12px] tracking-[2px] text-gold uppercase">
            Our commitment
          </span>
          <h3 class="mt-3 mb-2 type-h4 font-display text-bone uppercase">
            {bento.zeroWaste.title}
          </h3>
          <p class="m-0 max-w-[46ch] text-[16px] leading-[1.55] text-bone-88">
            {bento.zeroWaste.body}
          </p>
        </div>
      </article>
    </div>

    {/* Closing proof bar */}
    <div
      data-reveal
      class="mt-6 flex flex-wrap items-center justify-between gap-6 rounded-2xl bg-cream-card p-7 shadow-[0_1px_3px_rgba(1,20,58,0.08)]"
    >
      <div class="flex flex-wrap items-center gap-5">
        <div class="flex items-center gap-3">
          <div
            class="flex h-[62px] items-center justify-center rounded-xl bg-white px-5 shadow-[0_1px_3px_rgba(1,20,58,0.10)]"
          >
            <img
              src="/images/badge-aims.png"
              alt="AIMS certified"
              loading="lazy"
              class="max-h-10 w-auto object-contain"
            />
          </div>
          <div
            class="flex h-[62px] items-center justify-center rounded-xl bg-white px-5 shadow-[0_1px_3px_rgba(1,20,58,0.10)]"
          >
            <img
              src="/images/badge-world-athletics.png"
              alt="World Athletics certified course"
              loading="lazy"
              class="max-h-10 w-auto object-contain"
            />
          </div>
        </div>
        <p class="m-0 max-w-[34ch] text-[18px] leading-[1.5] text-navy-ink/85">
          Measured to international standards &mdash; your finish time counts
          toward the world's major marathons.
        </p>
      </div>

      <a
        href={event.registrationUrl}
        target="_blank"
        rel="noopener"
        class="group flex items-center gap-2 rounded-pill bg-navy-900 px-7 py-3.5 font-body text-[18px] font-bold text-white no-underline transition-colors duration-300 hover:bg-navy-800"
      >
        Register now
        <svg
          width="18"
          height="18"
          viewBox="0 0 20 20"
          fill="none"
          aria-hidden="true"
          class="transition-transform duration-300 group-hover:translate-x-1"
        >
          <path
            d="M4 10h12M11 5l5 5-5 5"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
