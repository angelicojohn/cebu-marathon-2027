---
/**
 * Perks for registered runners — the free community training runs and the
 * partner-hotel runner rates. On the live site these are two separate
 * pages (/community and /hotels); here they share one section, because
 * both answer the same question for someone deciding whether to sign up:
 * what do I get besides race day?
 *
 * Content is from those two pages. Hotels without published rates are
 * listed as "rates coming soon", as they are on the live site.
 */
import { hotels, trainingRuns, moments } from "../data/event";

/* A run is done once its date has passed. Checked at build time here, and
   again in the browser below so the list stays right between deploys. */
const today = new Date().toISOString().slice(0, 10);
const isDone = (on: string) => on < today;
const upcoming = trainingRuns.filter((r) => !isDone(r.on)).length;
const strip = [...moments, ...moments];

const peso = (n: number) => `₱${n.toLocaleString("en-PH")}`;
const from = (h: (typeof hotels)[number]) =>
  h.rates.length ? Math.min(...h.rates.map((r) => r.price)) : 0;
---

<section
  id="perks"
  class="pattern pattern--fade pattern--soft relative bg-cream py-[150px] max-[991px]:py-[120px] text-navy-ink max-[479px]:py-[96px]"
>
  <div class="relative z-[1] mx-auto w-full max-w-[1400px] px-6 max-[479px]:px-4">
    <div data-reveal class="mb-14 flex flex-col items-center gap-5 text-center">
      <div
        class="flex h-8 items-center justify-center rounded-pill border border-navy-ink/20 px-5 font-mono text-[0.8125rem] font-medium tracking-[1.5px] uppercase"
      >
        Perks &amp; offers
      </div>
      <h2 class="headline m-0 font-display text-navy-ink uppercase">
        More than <span class="script feather-text">race day</span>
      </h2>
      <p class="m-0 max-w-[58ch] text-[1.125rem] leading-[1.6] text-navy-ink/85">
        Registering gets you into ten free training runs with Cebu's run
        clubs, and runner rates at partner hotels.
      </p>
    </div>

    <div class="grid grid-cols-2 gap-6 max-[991px]:grid-cols-1">
      {/* Training runs */}
      <div data-reveal class="flex flex-col rounded-2xl bg-navy-950 p-8 text-bone max-[479px]:p-6">
        <div class="flex items-baseline justify-between gap-4">
          <h3 class="type-h4 m-0 font-display text-bone uppercase">Free training runs</h3>
          <span class="font-mono text-[0.75rem] tracking-[1.5px] text-aqua uppercase">
            {upcoming} of {trainingRuns.length} to go
          </span>
        </div>
        <p class="mt-3 mb-6 text-[1.125rem] leading-[1.55] text-bone-64">
          Free and exclusive to CM27 registered runners. The long runs build
          through the season to a 32K in December, then every club runs a 5K
          together the day before the race.
        </p>

        <ol class="m-0 flex list-none flex-col p-0">
          {
            trainingRuns.map((r) => (
              <li
                data-run={r.on}
                class:list={[
                  "run grid grid-cols-[72px_64px_1fr] items-center gap-4 border-t border-white/10 py-3.5 max-[479px]:grid-cols-[64px_48px_1fr] max-[479px]:gap-3",
                  isDone(r.on) && "is-done",
                ]}
              >
                <span class="font-display text-[1.125rem] font-black whitespace-nowrap text-bone uppercase max-[479px]:text-[0.9375rem]">
                  {r.date}
                </span>
                <span class:list={[
                  "inline-flex h-8 items-center justify-center rounded-pill font-display text-[0.9375rem] font-black tabular-nums",
                  r.shakeout ? "bg-gold text-white" : "bg-white/10 text-aqua",
                ]}>
                  {r.km}K
                </span>
                <span class="min-w-0">
                  <span class="block text-[1rem] font-semibold text-bone">
                    <span class="run__name">{r.club}</span>
                    {r.shakeout && <span class="font-normal text-bone-64"> · the day before the race</span>}
                    <span class="run__done">Done</span>
                  </span>
                  <span class="block font-mono text-[0.75rem] tracking-[1px] text-bone-40 uppercase">
                    {r.time}
                    {r.venue && <> &middot; {r.venue}</>}
                  </span>
                </span>
              </li>
            ))
          }
        </ol>
      </div>

      {/* Hotels */}
      <div data-reveal data-reveal-delay="120ms" class="flex flex-col rounded-2xl bg-cream-card p-8 shadow-[0_20px_50px_-30px_#01143a55] max-[479px]:p-6">
        <div class="flex items-baseline justify-between gap-4">
          <h3 class="type-h4 m-0 font-display text-navy-ink uppercase">Runner hotel rates</h3>
          <span class="font-mono text-[0.75rem] tracking-[1.5px] text-rose uppercase">
            Save up to ₱300
          </span>
        </div>
        <p class="mt-3 mb-6 text-[1.125rem] leading-[1.55] text-navy-ink/85">
          Show your Cebu Marathon registration confirmation code when you book
          direct with the hotel. Rates are per night.
        </p>

        <ul class="m-0 flex list-none flex-col p-0">
          {
            hotels.map((h) => (
              <li class="border-t border-navy-ink/10">
                {h.soon ? (
                  <div class="flex items-center justify-between gap-4 py-4">
                    <span class="text-[1.0625rem] font-semibold">{h.name}</span>
                    <span class="font-mono text-[0.75rem] tracking-[1px] text-navy-ink/45 uppercase">
                      Rates coming soon
                    </span>
                  </div>
                ) : (
                  <details class="group">
                    <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 [&::-webkit-details-marker]:hidden">
                      <span class="min-w-0">
                        <span class="block text-[1.0625rem] font-semibold">{h.name}</span>
                        {h.note && (
                          <span class="block font-mono text-[0.75rem] tracking-[1px] text-navy-ink/50 uppercase">
                            {h.note}
                          </span>
                        )}
                      </span>
                      <span class="flex flex-none items-center gap-3">
                        <span class="text-right">
                          <span class="block font-mono text-[0.625rem] tracking-[1px] text-navy-ink/45 uppercase">
                            {h.rates.length > 1 ? "From" : "Runner rate"}
                          </span>
                          <span class="block text-[1.125rem] font-bold tabular-nums">{peso(from(h))}</span>
                        </span>
                        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class="h-4 w-4 flex-none text-navy-ink/40 transition-transform duration-300 group-open:rotate-180">
                          <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </span>
                    </summary>
                    <ul class="m-0 mb-4 flex list-none flex-col gap-2 rounded-xl bg-cream-soft p-4">
                      {h.rates.map((r) => (
                        <li class="flex items-baseline justify-between gap-4 text-[1rem]">
                          <span class="text-navy-ink/85">{r.room}</span>
                          <span class="flex-none tabular-nums">
                            <s class="mr-2 text-navy-ink/35">{peso(r.was)}</s>
                            <strong class="font-bold">{peso(r.price)}</strong>
                          </span>
                        </li>
                      ))}
                    </ul>
                  </details>
                )}
              </li>
            ))
          }
        </ul>

        <p class="mt-auto border-t border-navy-ink/10 pt-5 text-[0.875rem] leading-[1.5] text-navy-ink/50">
          Cebu Marathon acts only as a hotel referral. Bookings, changes,
          cancellations and refunds follow each hotel's own policy.
        </p>
      </div>
    </div>

  </div>

  <div class="moments mt-20" aria-label="Photos from Cebu Marathon 2027 events so far">
    <div class="moments__track">
      {
        strip.map((m, i) => (
          <a
            href={m.post}
            target="_blank"
            rel="noopener"
            class="moments__item"
            aria-hidden={i >= moments.length ? "true" : undefined}
            tabindex={i >= moments.length ? -1 : undefined}
          >
            <img src={m.src} alt={i >= moments.length ? "" : `${m.caption} — view the post on Facebook`} loading="lazy" width="900" height="600" />
            <span class="moments__caption">{m.caption}</span>
            <span class="moments__view" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.07C24 5.41 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.5 0-1.96.93-1.96 1.89v2.26h3.33l-.53 3.5h-2.8V24C19.62 23.1 24 18.1 24 12.07Z"/></svg>
              View on Facebook
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<script>
  /* Re-mark finished runs in the browser, so a run is struck through the
     morning after it happens even if the site was built earlier. */
  const today = new Date().toISOString().slice(0, 10);
  document.querySelectorAll<HTMLElement>("[data-run]").forEach((row) => {
    row.classList.toggle("is-done", (row.dataset.run ?? "") < today);
  });
</script>
