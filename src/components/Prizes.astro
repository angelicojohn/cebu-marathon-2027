---
/**
 * Cash prizes — after the distance cards, following the official 2027
 * prize boards.
 *
 * Four columns, one per distance. Each opens with the same skewed navy
 * plate and script numeral as the distance cards, and the prize ribbon
 * beneath it unrolls downward once the section scrolls into view, the rows
 * arriving one after another from Champion to 5th place.
 *
 * Below, the smaller purses: the age-group categories (42K and 21K only),
 * most festive costume and oldest runner.
 *
 * Every amount is paid identically in the male and female divisions.
 */
import { prizes, paletteVars } from "../data/event";

const peso = (n: number) => `₱${n.toLocaleString("en-PH")}`;
const places = ["Champion", "2nd place", "3rd place", "4th place", "5th place"];
const podium = ["1st place", "2nd place", "3rd place"];
---

<section
  id="prizes"
  class="prizes pattern pattern--soft relative overflow-hidden py-[150px] max-[991px]:py-[120px] text-navy-ink max-[479px]:py-[96px]"
  data-prizes
>
  <div class="relative z-[1] mx-auto w-full max-w-[1400px] px-6 max-[479px]:px-4">
    {/* Heading */}
    <div data-reveal class="mb-16 flex flex-col items-center gap-5 text-center">
      <div
        class="flex h-8 items-center justify-center rounded-pill border border-rose/40 bg-rose/10 px-5 font-mono text-[13px] font-medium tracking-[1.5px] text-rose uppercase"
      >
        Male and female
      </div>
      <h2 class="headline m-0 font-display text-navy-ink uppercase">
        Cash <span class="script feather-text feather-text--deep">prizes</span>
      </h2>
      <p class="m-0 max-w-[58ch] text-[18px] leading-[1.6] text-navy-ink/85">
        Every purse below is paid twice — once in the male division, once in
        the female — across all four distances.
      </p>
    </div>

    {/* Open prizes */}
    <div class="prize-grid grid grid-cols-4 gap-5 max-[1023px]:grid-cols-2 max-[1023px]:gap-y-12 max-[479px]:grid-cols-1">
      {
        prizes.open.map((col, c) => (
          <div class="prize-col" style={`${paletteVars(col.id)};--c:${c}`}>
            <div class="prize-plate">
              <span class="prize-plate__inner">
                <span class="race-badge__num prize-plate__num">
                  {col.distance.replace(/K$/, "")}
                </span>
                <span class="race-badge__k prize-plate__k">K</span>
              </span>
            </div>

            <ol class="prize-ribbon">
              {col.amounts.map((amount, r) => (
                <li class="prize-row" style={`--r:${r}`}>
                  <span class="prize-row__place">{places[r]}</span>
                  <span class="prize-row__amount">{peso(amount)}</span>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </div>

    {/* Special categories */}
    <div class="mt-24 grid grid-cols-[1.35fr_1fr_1fr] gap-6 max-[1023px]:grid-cols-1">
      {/* Age groups */}
      <div data-reveal class="prize-panel">
        <h3 class="type-h4 m-0 font-display uppercase">Age-group categories</h3>
        <p class="mt-2 mb-5 text-[16px] leading-[1.5] text-navy-ink/85">
          Paid in each of four brackets, male and female:{" "}
          <strong class="font-semibold text-navy-ink">
            {prizes.ageGroup.brackets.join(" · ")}
          </strong>
        </p>
        <div class="grid grid-cols-2 gap-3 max-[479px]:grid-cols-1">
          {
            prizes.ageGroup.tiers.map((t) => (
              <div class="prize-mini" style={paletteVars(t.id)}>
                <div class="prize-mini__head"><span>{t.distance}</span></div>
                {t.amounts.map((a, i) => (
                  <div class="prize-mini__row">
                    <span>{podium[i]}</span>
                    <strong>{peso(a)}</strong>
                  </div>
                ))}
              </div>
            ))
          }
        </div>
      </div>

      {/* Costume */}
      <div data-reveal data-reveal-delay="100ms" class="prize-panel prize-panel--dark">
        <h3 class="type-h4 m-0 font-display text-bone uppercase">Most festive costume</h3>
        <p class="mt-2 mb-5 text-[16px] leading-[1.5] text-bone-64">
          Top three costumes on race day.
        </p>
        {
          prizes.costume.map((a, i) => (
            <div class="prize-dark-row">
              <span>{podium[i]}</span>
              <strong>{peso(a)}</strong>
            </div>
          ))
        }
      </div>

      {/* Oldest runner */}
      <div data-reveal data-reveal-delay="200ms" class="prize-panel prize-panel--dark">
        <h3 class="type-h4 m-0 font-display text-bone uppercase">Oldest runner</h3>
        <p class="mt-2 mb-5 text-[16px] leading-[1.5] text-bone-64">
          One male and one female winner, 42K only.
        </p>
        {
          prizes.oldest.map((o) => (
            <div class="prize-dark-row">
              <span>
                {o.label} <span class="text-bone-40">({o.note})</span>
              </span>
              <strong>{peso(o.amount)}</strong>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  /* The ribbons unroll when the columns scroll into view. One observer on
     the grid, so all four open together on a shared, staggered cue. */
  const grid = document.querySelector<HTMLElement>("[data-prizes] .prize-grid");
  if (grid) {
    const open = () => grid.classList.add("is-open");
    if (!("IntersectionObserver" in window)) open();
    else {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            open();
            io.disconnect();
          }
        },
        { threshold: 0.2 },
      );
      io.observe(grid);
    }
  }
</script>
